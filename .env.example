# ── Hermes API ──────────────────────────────────────────────────────────────
# Base URL of the Hermes agent server (OpenAI-compatible, default port 8642)
HERMES_BASE_URL=http://localhost:8642

# API key for the Hermes server (set API_SERVER_KEY in hermes config)
HERMES_API_KEY=

# Model name sent in requests (ignored by Hermes unless direct_model_requests: true)
HERMES_MODEL=hermes-agent

# System prompt injected before every user message — the "predefined prompt"
HERMES_SYSTEM_PROMPT=You are a helpful assistant. Process the following voice note and respond concisely.

# Response generation limits
HERMES_MAX_TOKENS=1024
HERMES_TEMPERATURE=0.7

# HTTP timeout in seconds for Hermes calls
HERMES_TIMEOUT_SECONDS=30.0

# ── Whisper STT (optional) ───────────────────────────────────────────────────
# Leave blank to disable audio-only mode. Set to an OpenAI-compatible Whisper
# endpoint when the Pebble is configured to send raw audio without transcription.
WHISPER_BASE_URL=
WHISPER_API_KEY=
WHISPER_MODEL=whisper-1

# ── Webhook security ─────────────────────────────────────────────────────────
# If set, the webhook endpoint requires:  Authorization: Bearer <token>
# Configure the same token in the Pebble app → Advanced → Custom headers.
WEBHOOK_AUTH_TOKEN=

# ── App ──────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# Port the server listens on (remapped via Docker -p, not inside the container)
PORT=8000
